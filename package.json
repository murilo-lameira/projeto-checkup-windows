{
  "name": "checkup-windows",
  "version": "1.0.0",
  "description": "Dashboard Central de Monitoramento e Manutenção",
  "author": "Murilo Lameira",
  "main": "main.js",
  "scripts": {
    "start": "node -e \"delete process.env.ELECTRON_RUN_AS_NODE; const cp = require('child_process'); const p = cp.spawn(require('electron'), ['.'], { stdio: 'inherit', env: process.env }); p.on('close', code => process.exit(code ?? 0));\"",
    "build": "npm run icon:build && electron-builder --win",
    "validate": "node --check main.js && node --check src/renderer.js",
    "icon:build": "node scripts/convert-icon.js",
    "agents:pixel": "node scripts/pixel_agents_bridge.js",
    "agents:pixel:clear": "node scripts/pixel_agents_bridge.js --clean"
  },
  "dependencies": {
    "systeminformation": "^5.23.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-reloader": "^1.2.3",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.checkup.dashboard",
    "productName": "CheckUP Windows",
    "asar": true,
    "win": {
      "target": "portable",
      "requestedExecutionLevel": "highestAvailable",
      "icon": "src/assets/icon.ico"
    },
    "extraResources": [
      "core/checkup.ps1"
    ]
  }
}
